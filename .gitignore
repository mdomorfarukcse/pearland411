# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
nbproject/

# Backups / archives — never commit
*.zip
*.bak
*.backup
*-backup.*
*.orig

# Logs (keep the directory + index.html, ignore log contents)
application/logs/*
!application/logs/index.html

# CodeIgniter cache (keep the directory + index.html)
application/cache/*
!application/cache/index.html

# CI session files
application/cache/ci_session_*

# Local config overrides (never commit secrets)
application/config/database.php
application/config/database.local.php
application/config/authorize_net.local.php
application/config/email.local.php
.env
.env.local

# User uploads — content, not code (but track .htaccess + index.html
# so the no-exec policy and directory-listing block are in git)
uploads/*
!uploads/index.html
!uploads/.gitkeep
!uploads/.htaccess

# Composer (we don't ship vendor/)
/vendor/
composer.phar

# Build output
node_modules/
dist/

# throw-away offline render harness output
_preview_*.html
