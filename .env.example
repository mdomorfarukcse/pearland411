# Pearland411 environment configuration
# Copy this file to `.env` at the repo root and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ----------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------
# One of: production, testing, development
CI_ENV=production
BASE_URL=https://pearland411.com/

# 32-byte random string. Generate with:
#   php -r 'echo bin2hex(random_bytes(16)), "\n";'
ENCRYPTION_KEY=

# ----------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
DB_DRIVER=mysqli

# ----------------------------------------------------------------------
# Outgoing email
# ----------------------------------------------------------------------
# Check this with /admin/email-diagnostics (super-admin) or
#   php index.php cli mail_test you@example.com
# Both print the effective settings, flag the known-bad combinations, and
# send a real message showing the mail server's own error if it refuses.
#
# THE ONE THAT BITES: MAIL_FROM_ADDRESS must be an address the SMTP account
# is authorised to send as. Relaying through a Gmail account while claiming
# to be no-reply@pearland411.com fails SPF/DMARC at the recipient, and Gmail
# and Outlook discard such messages outright — no Inbox, no Spam, no bounce.
# Either set MAIL_FROM_ADDRESS to the SMTP account's own address, or use a
# provider (Google Workspace, SES, Postmark, Mailgun, the cPanel mailbox on
# the domain itself) where pearland411.com is verified and DKIM-signed.
#
# SMTP_HOST=smtp.gmail.com + an App Password (2-step verification on; the
# account password does NOT work). Port 587 pairs with SMTP_CRYPTO=tls,
# port 465 with SMTP_CRYPTO=ssl.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_CRYPTO=tls
# Seconds to wait on the SMTP conversation. CodeIgniter's own default is 5,
# which a shared host opening TLS to a public relay regularly overshoots —
# and the timeout is indistinguishable from a wrong password. Default 30.
SMTP_TIMEOUT=30
MAIL_FROM_ADDRESS=no-reply@pearland411.com
MAIL_FROM_NAME=Pearland411
# Transport override: smtp / mail / sendmail. Leave blank to choose
# automatically — SMTP when SMTP_HOST+USER+PASS are all set, otherwise the
# host's own MTA. Set it to `mail` on a cPanel-style host that relays local
# mail for the domain, which is usually better authenticated than an
# external relay borrowed from another domain.
MAIL_PROTOCOL=
# Only read when MAIL_PROTOCOL=sendmail.
MAIL_SENDMAIL_PATH=/usr/sbin/sendmail

# ----------------------------------------------------------------------
# Google reCAPTCHA v2 — the "I'm not a robot" box on the public forms
# (contact, quotes, registration, password reset, newsletter).
# Create a "reCAPTCHA v2 > I'm not a robot Checkbox" key for your domain
# at https://www.google.com/recaptcha/admin and paste both halves here.
# Leave blank to run without it (the hidden trap field still applies).
# On/off switch: /admin/setting > Spam protection.
# ----------------------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ----------------------------------------------------------------------
# Helcim (payment processor)
# HelcimPay.js hosted checkout + card vault for recurring charges.
# Get your API token in the Helcim dashboard: Settings > Integrations > API.
# API base: https://api.helcim.com/v2/  (auth via the `api-token` header)
# ----------------------------------------------------------------------
HELCIM_API_TOKEN=
HELCIM_CURRENCY=USD
# Token used to verify inbound Helcim webhook signatures (Settings > Webhooks).
HELCIM_WEBHOOK_VERIFIER_TOKEN=

# ----------------------------------------------------------------------
# SEO / Analytics / Webmaster tooling
# All optional — leave blank to skip the corresponding <meta> / <script>.
# Tags are emitted by application/views/partials/seo_head.php.
# ----------------------------------------------------------------------
# GA4 measurement ID (e.g. G-XXXXXXX). Enables sitewide gtag.js.
GOOGLE_ANALYTICS_ID=
# Google Search Console domain-property verification token (the value
# inside content="..." on the meta tag GSC asks you to paste).
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token (msvalidate.01).
BING_SITE_VERIFICATION=
# Facebook App ID (for og:type=article / better share analytics).
FACEBOOK_APP_ID=

# ----------------------------------------------------------------------
# Social profile URLs — surfaced in the public footer once set.
# Leave blank to keep the social icons hidden.
# ----------------------------------------------------------------------
SOCIAL_FACEBOOK_URL=
SOCIAL_TWITTER_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_YOUTUBE_URL=
