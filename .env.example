# Pearland411 environment configuration
# Copy this file to `.env` at the repo root and fill in real values.
# `.env` is gitignored — never commit real credentials.

# ----------------------------------------------------------------------
# Application
# ----------------------------------------------------------------------
# One of: production, testing, development
CI_ENV=production
BASE_URL=https://new.pearland411.com/

# 32-byte random string. Generate with:
#   php -r 'echo bin2hex(random_bytes(16)), "\n";'
ENCRYPTION_KEY=

# ----------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------
DB_HOST=localhost
DB_USER=
DB_PASS=
DB_NAME=
DB_DRIVER=mysqli

# ----------------------------------------------------------------------
# SMTP (Gmail or any provider)
# For Gmail use an App Password, not your account password.
# ----------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_CRYPTO=tls
MAIL_FROM_ADDRESS=no-reply@pearland411.com
MAIL_FROM_NAME=Pearland411

# ----------------------------------------------------------------------
# Authorize.Net
# Sandbox endpoint: https://apitest.authorize.net/xml/v1/request.api
# Production endpoint: https://api.authorize.net/xml/v1/request.api
# ----------------------------------------------------------------------
AUTHNET_ENVIRONMENT=sandbox
AUTHNET_API_LOGIN_ID=
AUTHNET_TRANSACTION_KEY=
AUTHNET_SIGNATURE_KEY=
AUTHNET_CLIENT_KEY=
AUTHNET_ENDPOINT_URL=https://apitest.authorize.net/xml/v1/request.api
AUTHNET_CURRENCY=USD
AUTHNET_WEBHOOK_URL=

# ----------------------------------------------------------------------
# SEO / Analytics / Webmaster tooling
# All optional — leave blank to skip the corresponding <meta> / <script>.
# Tags are emitted by application/views/partials/seo_head.php.
# ----------------------------------------------------------------------
# GA4 measurement ID (e.g. G-XXXXXXX). Enables sitewide gtag.js.
GOOGLE_ANALYTICS_ID=
# Google Search Console domain-property verification token (the value
# inside content="..." on the meta tag GSC asks you to paste).
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools verification token (msvalidate.01).
BING_SITE_VERIFICATION=
# Facebook App ID (for og:type=article / better share analytics).
FACEBOOK_APP_ID=

# ----------------------------------------------------------------------
# Social profile URLs — surfaced in the public footer once set.
# Leave blank to keep the social icons hidden.
# ----------------------------------------------------------------------
SOCIAL_FACEBOOK_URL=
SOCIAL_TWITTER_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_LINKEDIN_URL=
SOCIAL_YOUTUBE_URL=
