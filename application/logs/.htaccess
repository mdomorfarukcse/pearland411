# CodeIgniter's log files. application/ is not meant to be web-served at all
# (the document root is the repo root and index.php front-controls everything),
# but a mis-set DocumentRoot would otherwise expose log-2026-09-24.php — which
# contains SMTP transcripts, stack traces and query text.
Require all denied

# Apache 2.2 fallback, for hosts still running it.
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
